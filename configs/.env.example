# Lumina 拾光人像画室环境变量示例（按需复制为 .env 或在启动命令前传入）
# 请勿将真实密钥或私有令牌提交至版本库。

# 多模态基座模型（本地目录路径或 Hugging Face 模型 ID）
PORTRAIT_BASE_MODEL=Qwen/Qwen3-VL-2B-Instruct

# 六工具 LoRA 权重目录（默认自动指向仓库内置的 weights/six_tool_lora_v1）
# PORTRAIT_SIX_TOOL_ADAPTER=./weights/six_tool_lora_v1

# 原生人像引擎 MediaPipe 视觉模型缓存目录（首次运行可自动下载）
LUMINA_VISION_MODEL_DIR=./models/vision

# Web Demo 运行配置
PORTRAIT_DEMO_PLANNER=six1800
PORTRAIT_GPU_ID=0
PORTRAIT_DEMO_HOST=127.0.0.1
PORTRAIT_DEMO_PORT=8787
